# Local dev: Cloudflare tunnel URL for the Snowie Django backend.
# Regenerate when the tunnels restart (quick-tunnel URLs are ephemeral).
VITE_SNOWIE_API_URL=https://embedded-photographer-mathematical-faces.trycloudflare.com

# VITE_AGNI_PROXY_URL is intentionally unset: api/agni.ts is a Vercel
# serverless proxy, not the Django backend. Set it only when running
# `npx vercel dev` locally (e.g. http://localhost:3000/api/agni).
