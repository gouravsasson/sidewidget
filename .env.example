# One persistent Microsoft Dev Tunnel shared by the backend, frontend, and widget.
# The ID is chosen during the one-time setup documented in README.md.
SNOWIE_TUNNEL_ID=your-unique-snowie-tunnel-id

# India Central is used by the team's existing tunnel URLs. Change this if the
# `devtunnel host` output shows another region.
SNOWIE_TUNNEL_REGION=inc1
